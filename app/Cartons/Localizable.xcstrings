    "Every scan from label to doorstep, in one tidy list.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Jeder Scan vom Etikett bis zur Haustür, in einer übersichtlichen Liste."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cada escaneo, de la etiqueta a tu puerta, en una lista ordenada."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Chaque scan, de l'étiquette à votre porte, dans une liste claire."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ogni scansione, dall'etichetta alla porta, in un unico elenco ordinato."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ラベル発行から玄関まで、すべてのスキャンをひとつのリストに。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "라벨부터 문 앞까지 모든 스캔을 깔끔한 목록 하나로."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Cada leitura, da etiqueta até a porta, numa lista organizada."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "从贴标签到送上门，每次扫描都在一个清爽的列表里。"
          }
        }
      }
    },
