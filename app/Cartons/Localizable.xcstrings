    "Cartons": {
      "shouldTranslate": false
    },
    "Cartons sees a UPS number on your clipboard and fills it in for you.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Cartons erkennt eine UPS-Nummer in deiner Zwischenablage und trägt sie für dich ein."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cartons ve un número de UPS en tu portapapeles y lo rellena por ti."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cartons repère un numéro UPS dans le presse-papiers et le remplit pour vous."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Cartons vede un numero UPS negli appunti e lo inserisce per te."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "クリップボードの UPS 番号を Cartons が見つけて入力します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Cartons가 클립보드의 UPS 번호를 찾아 대신 입력합니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Cartons vê um número da UPS na sua área de transferência e preenche para você."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
