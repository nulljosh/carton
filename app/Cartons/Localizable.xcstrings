    "Keeps your packages the same on every device signed into your Apple Account. Nothing goes to our servers. We don't have any.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Hält deine Pakete auf allen Geräten mit deinem Apple Account gleich. Nichts geht an unsere Server. Wir haben keine."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantiene tus paquetes iguales en todos los dispositivos con tu cuenta de Apple. Nada va a nuestros servidores. No tenemos ninguno."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Garde vos colis identiques sur tous les appareils connectés à votre compte Apple. Rien ne passe par nos serveurs. Nous n'en avons pas."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantiene i pacchi uguali su tutti i dispositivi con il tuo Apple Account. Niente passa dai nostri server. Non ne abbiamo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "同じ Apple アカウントのすべてのデバイスで荷物を同期します。こちらのサーバーには何も送りません。そもそもサーバーがありません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "같은 Apple 계정의 모든 기기에서 택배 목록을 똑같이 유지합니다. 저희 서버로는 아무것도 가지 않아요. 서버가 없거든요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantém seus pacotes iguais em todos os dispositivos com sua Conta Apple. Nada vai para nossos servidores. Não temos nenhum."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在登录同一 Apple 账户的所有设备上保持包裹一致。不经过我们的服务器，我们也没有服务器。"
          }
        }
      }
    },
