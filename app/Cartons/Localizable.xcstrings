    "A big countdown to delivery day. No account, no ads, nothing to sign up for.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein großer Countdown bis zum Liefertag. Kein Konto, keine Werbung, keine Anmeldung."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Una gran cuenta atrás hasta el día de entrega. Sin cuenta, sin anuncios, sin registros."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un grand compte à rebours jusqu'au jour de livraison. Pas de compte, pas de pub, rien à créer."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Un grande conto alla rovescia fino al giorno di consegna. Niente account, niente pubblicità, niente iscrizioni."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "配達日まで大きくカウントダウン。アカウントも広告も登録も不要です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "배송일까지 큰 카운트다운. 계정도, 광고도, 가입도 없습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Uma grande contagem regressiva até o dia da entrega. Sem conta, sem anúncios, sem cadastro."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "醒目的送达倒计时。无需账户，没有广告，不用注册。"
          }
        }
      }
    },
